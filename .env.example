# Copying this file alone is insufficient: `./scripts/zu setup` generates local passwords.
POSTGRES_PORT=55432
POSTGRES_DB=zutrade
POSTGRES_USER=zutrade_admin
POSTGRES_PASSWORD=replace-with-generated-local-secret
RUNTIME_DB_USER=zutrade_runtime
RUNTIME_DB_PASSWORD=replace-with-another-generated-local-secret
DATABASE_URL=postgresql://zutrade_runtime:replace-with-another-generated-local-secret@127.0.0.1:55432/zutrade
API_PORT=3001
WEB_PORT=5173
WORKER_PORT=3002
WORKER_HEARTBEAT_MS=5000
WORKER_STALE_MS=15000
PRIVATE_DATA_DIR=./data/private
CHANNEL_MODE=simulation
AI_MODE=mock
PROSPECTING_MODE=live_public_directory
WORKSPACE_TIMEZONE=Asia/Shanghai

# A1: ./scripts/zu db:configure appends independent generated secrets for:
# MIGRATION_DATABASE_URL, API_DATABASE_URL, WORKER_DATABASE_URL, AUTH_DATABASE_URL, BETTER_AUTH_SECRET.
# Never copy a migration/admin credential into an API or worker URL.

# C: db:configure also generates SIMULATION_DATABASE_URL for zutrade_simulation.
# API/worker business roles cannot access the independent simulation schema.

# D1: optional Brave keyword search. Public directories need none of these.
# Keep the key and entitlement reference in local ignored .env only.
# BRAVE_SEARCH_API_KEY=<local-secret>
BRAVE_SEARCH_STORAGE_RIGHTS=unconfirmed
# BRAVE_SEARCH_RIGHTS_REFERENCE=<local-contract-or-plan-proof>
