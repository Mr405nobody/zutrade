{
  "name": "zutrade",
  "version": "0.0.0-stage.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "infra:up": "node scripts/infra.mjs up",
    "infra:stop": "node scripts/infra.mjs stop",
    "infra:start": "node scripts/infra.mjs start",
    "infra:status": "node scripts/infra.mjs status",
    "infra:logs": "node scripts/infra.mjs logs",
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm -r --sort typecheck && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint . && node scripts/boundaries.mjs && prettier --check .",
    "format": "prettier --write .",
    "dev": "pnpm build && node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @zutrade/web dev",
    "dev:api": "pnpm --filter @zutrade/api dev",
    "dev:worker": "pnpm --filter @zutrade/worker dev",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "db:configure": "node scripts/a1-configure.mjs",
    "db:provision": "node scripts/db-provision.mjs",
    "db:migrate": "node scripts/baseline-copy.mjs --check && node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:accounts": "node scripts/db-accounts.mjs",
    "auth:generate": "auth generate --config scripts/auth-generate-config.mjs --output .local/auth-proposed.sql --yes",
    "test:integration": "node scripts/verify-a1.mjs",
    "db:queue-maintain": "node scripts/db-queue-maintain.mjs",
    "verify:persistence": "node scripts/verify-a1-persistence.mjs",
    "test:a2": "node scripts/verify-a2.mjs",
    "test:a2:inbound": "node scripts/verify-a2-inbound.mjs",
    "test:a2:browser": "node scripts/a2-browser-fixture.mjs && playwright test a2.spec.ts",
    "db:seed:b": "node scripts/b-seed.mjs",
    "test:b": "node scripts/verify-b.mjs",
    "test:b:supply": "node scripts/verify-b-supply.mjs",
    "test:b:pdf": "node scripts/verify-b-pdf.mjs",
    "test:b:browser": "playwright test b.spec.ts",
    "test:c": "node scripts/verify-c.mjs",
    "test:c:browser": "node scripts/verify-c-browser.mjs",
    "demo:c": "node scripts/c-demo-prepare.mjs",
    "ui:c": "node scripts/c-ui-serve.mjs",
    "test:d1": "node scripts/verify-d1.mjs",
    "test:d1:browser": "node scripts/verify-d1-browser.mjs",
    "prospecting:live": "node scripts/prospecting-live.mjs",
    "ui:d1": "node scripts/d1-ui-serve.mjs",
    "test:d2": "node scripts/verify-d2.mjs",
    "test:d2:browser": "node scripts/verify-d2-browser.mjs",
    "ui:d2": "node scripts/d2-ui-serve.mjs",
    "test:e": "node scripts/verify-e.mjs",
    "test:e:browser": "node scripts/verify-e-browser.mjs",
    "ui:e": "node scripts/e-ui-serve.mjs",
    "test:v": "node scripts/verify-v.mjs",
    "test:v:recovery": "node scripts/verify-v-recovery.mjs",
    "test:v:browser": "node scripts/verify-v-browser.mjs",
    "ui:v": "node scripts/v-ui-serve.mjs",
    "test:outbound": "node scripts/verify-outbound.mjs",
    "ui:outbound": "node scripts/outbound-ui-serve.mjs",
    "test:outbound:browser": "node scripts/verify-outbound-browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@zutrade/db": "workspace:*",
    "@zutrade/domain": "workspace:*",
    "@zutrade/storage": "workspace:*",
    "auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "@zutrade/contracts": "workspace:*",
    "@zutrade/channels": "workspace:*",
    "@zutrade/prospecting": "workspace:*",
    "@zutrade/ai": "workspace:*"
  }
}
